{
  "name": "@haulbook/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Haul Book contracts: zod schemas and TypeScript types for the whole API surface, plus constants. Consumed by apps/api and apps/web via a file: dependency.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
