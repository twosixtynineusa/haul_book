// Haul Book Prisma schema — PostgreSQL 18, cuid() string ids, UTC timestamps.
//
// Company / Unit: the saved company → unit list behind the portal's pickers. It
// fills itself: every successful conversion upserts its companies and units
// (CompaniesService). Companies match case- and spacing-insensitively via
// `nameKey` (= companyKey(name) in @haulbook/shared); the first spelling seen is kept.
// A Unit is one truck, so it also holds the truck's last known odometer. Both are
// also edited by hand on the portal's Companies tab (details, rename, merge, delete).
//
// Company.sources: the source formats (SourceFormatId) approved for the company.
// The first conversion approves its format; a file in any other format waits for
// the user to confirm the switch (owners move between ELD providers).
//
// InboxFile: one row per file found in the watched input folder (InboxService).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String
  nameKey     String   @unique @map("name_key")
  /// Approved source formats; empty = none yet (the next conversion's format is approved).
  sources     String[] @default([])
  dotNumber   String?  @map("dot_number")
  iftaAccount String?  @map("ifta_account")
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  units       Unit[]

  @@map("companies")
}

model Unit {
  id              String    @id @default(cuid())
  companyId       String    @map("company_id")
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number          String
  /// The truck's odometer at the end of its latest converted period (begin + miles).
  /// Only real readings are saved, never the placeholder `1`. The next conversion
  /// of a later period uses it as Begin Odo when none is typed.
  odometer        Decimal?  @db.Decimal(12, 1)
  /// End date of the period `odometer` was measured at (a wall-clock date, held as UTC).
  odometerAsOf    DateTime? @map("odometer_as_of") @db.Date
  vin             String?
  plate           String?
  notes           String?
  /// Set by each conversion: the source format, the end of its latest trip, and when.
  lastSource      String?   @map("last_source")
  lastPeriodEnd   DateTime? @map("last_period_end") @db.Date
  lastConvertedAt DateTime? @map("last_converted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, number])
  @@map("units")
}

/// Lifecycle of a file found in INPUT_DIR. Active: waiting, processing,
/// needs_input, failed (the file is still in the input folder). Final:
/// converted, duplicate (moved to archive/), dismissed (moved to failed/).
enum InboxStatus {
  waiting
  processing
  needs_input
  failed
  converted
  duplicate
  dismissed
}

model InboxFile {
  id            String      @id @default(cuid())
  /// Where the file is (relative to INPUT_DIR) while active; where it was once final.
  path          String
  name          String
  /// Company from the subfolder it was dropped in (INPUT_DIR/<company>/file).
  folderCompany String?     @map("folder_company")
  /// Size + mtime at the last scan: a file is processed once these stop changing.
  size          Int
  mtimeMs       Float       @map("mtime_ms")
  sha256        String?
  status        InboxStatus @default(waiting)
  /// Format / company / unit as last resolved (detected, from the folder, or entered).
  format        String?
  company       String?
  unit          String?
  /// What the user still has to supply (SourceNeed values).
  needs         String[]
  error         String?
  /// When needs = source: the company's approved formats, for the warning.
  knownSources  String[]    @default([]) @map("known_sources")
  /// The user confirmed converting from a format new for this company.
  confirmSource Boolean     @default(false) @map("confirm_source")
  /// ProMiles file(s) written to OUTPUT_DIR.
  outputs       String[]
  /// Where the source went (relative to INPUT_DIR): archive/<date>/… or failed/….
  archivedPath  String?     @map("archived_path")
  processedAt   DateTime?   @map("processed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([status])
  @@index([path])
  @@index([sha256])
  @@map("inbox_files")
}
