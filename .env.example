# Haul Book — local environment. Copied to .env (git-ignored) by `make setup`.
# Docker-first: the app runs inside compose; nothing is installed on the host.

# Folder ON THIS MACHINE where converted ProMiles files are saved. It is
# bind-mounted into the api container, so every converted file appears here
# (pick it up for the ProMiles import) and is also downloadable from the portal.
# Relative paths are relative to this project folder; absolute paths work too:
#   Linux / macOS:  OUTPUT_DIR=/home/you/HaulBook/ProMiles-import
#   Windows (WSL):  OUTPUT_DIR=/mnt/c/Users/you/Documents/HaulBook/ProMiles-import
#                   (C:\Users\you\... seen from WSL; spaces in the path are fine)
# Docker Desktop on macOS: the folder must be under a shared path (your home dir is by default).
OUTPUT_DIR=./output

# Watched input folder ON THIS MACHINE (same path rules as OUTPUT_DIR, e.g.
# /mnt/c/Users/you/Documents/HaulBook/Inbox on Windows). Drop source reports here (or in a
# subfolder named after the company, e.g. "ACME TRUCKING LLC/") and they
# convert automatically; the originals move to INPUT_DIR/archive/<date>/. Files
# missing a company or unit # wait in the portal's Inbox until you fill them in.
INPUT_DIR=./input
# How often the folder is scanned, in seconds. A file is picked up once it has
# stopped changing between two scans.
INPUT_SCAN_SECONDS=30

# Host ports. Change them if another local stack already uses 3100 / 3000.
WEB_PORT=3100
API_PORT=3000
# Host port for your own psql/DB tools only (the app uses db:5432 inside Docker).
# 5433 by default because other local stacks often hold 5432.
DB_PORT=5433
